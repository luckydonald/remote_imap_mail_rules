{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rules.schema.json",
  "title": "RuleFile",
  "$defs": {
    "AbsoluteTime": {
      "description": "A fixed point in time. Naive datetimes are taken as UTC.",
      "properties": {
        "relative": {
          "const": false,
          "default": false,
          "title": "Relative",
          "type": "boolean"
        },
        "value": {
          "format": "date-time",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "AbsoluteTime",
      "type": "object"
    },
    "AddressCondition": {
      "additionalProperties": false,
      "description": "Compares an address field, at the granularity given by `part`.",
      "properties": {
        "type": {
          "const": "address",
          "default": "address",
          "title": "Type",
          "type": "string"
        },
        "field": {
          "$ref": "#/$defs/Templatable_AddressField_"
        },
        "part": {
          "$ref": "#/$defs/Templatable_AddressPart_",
          "default": "address"
        },
        "operator": {
          "$ref": "#/$defs/Templatable_TextOperator_"
        },
        "value": {
          "$ref": "#/$defs/Templatable_Union_str__list_str___"
        },
        "case_sensitive": {
          "$ref": "#/$defs/Templatable_bool_",
          "default": false
        },
        "quantifier": {
          "$ref": "#/$defs/Templatable_Quantifier_",
          "default": "any"
        }
      },
      "required": [
        "field",
        "operator",
        "value"
      ],
      "title": "AddressCondition",
      "type": "object"
    },
    "AddressField": {
      "description": "Fields holding one or more email addresses.",
      "enum": [
        "from",
        "sender",
        "reply_to",
        "return_path",
        "to",
        "cc",
        "bcc",
        "recipients",
        "delivered_to"
      ],
      "title": "AddressField",
      "type": "string"
    },
    "AddressPart": {
      "description": "Which part of an address to compare, so rules can match `Max <m@example.com>` at the wanted granularity.",
      "enum": [
        "full",
        "name",
        "address",
        "local_part",
        "domain"
      ],
      "title": "AddressPart",
      "type": "string"
    },
    "AllExpression": {
      "additionalProperties": false,
      "description": "AND: true if every nested expression is true.",
      "properties": {
        "type": {
          "const": "all",
          "default": "all",
          "title": "Type",
          "type": "string"
        },
        "conditions": {
          "items": {
            "discriminator": {
              "mapping": {
                "address": "#/$defs/AddressCondition",
                "all": "#/$defs/AllExpression",
                "any": "#/$defs/AnyExpression",
                "bool": "#/$defs/BoolCondition",
                "date": "#/$defs/DateCondition",
                "header": "#/$defs/HeaderCondition",
                "not": "#/$defs/NotExpression",
                "number": "#/$defs/NumberCondition",
                "presence": "#/$defs/PresenceCondition",
                "template": "#/$defs/Template_Expression_",
                "text": "#/$defs/TextCondition"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/AllExpression"
              },
              {
                "$ref": "#/$defs/AnyExpression"
              },
              {
                "$ref": "#/$defs/NotExpression"
              },
              {
                "$ref": "#/$defs/TextCondition"
              },
              {
                "$ref": "#/$defs/HeaderCondition"
              },
              {
                "$ref": "#/$defs/AddressCondition"
              },
              {
                "$ref": "#/$defs/NumberCondition"
              },
              {
                "$ref": "#/$defs/DateCondition"
              },
              {
                "$ref": "#/$defs/BoolCondition"
              },
              {
                "$ref": "#/$defs/PresenceCondition"
              },
              {
                "$ref": "#/$defs/Template_Expression_"
              }
            ]
          },
          "minItems": 1,
          "title": "Conditions",
          "type": "array"
        }
      },
      "required": [
        "conditions"
      ],
      "title": "AllExpression",
      "type": "object"
    },
    "AnyExpression": {
      "additionalProperties": false,
      "description": "OR: true if at least one nested expression is true.",
      "properties": {
        "type": {
          "const": "any",
          "default": "any",
          "title": "Type",
          "type": "string"
        },
        "conditions": {
          "items": {
            "discriminator": {
              "mapping": {
                "address": "#/$defs/AddressCondition",
                "all": "#/$defs/AllExpression",
                "any": "#/$defs/AnyExpression",
                "bool": "#/$defs/BoolCondition",
                "date": "#/$defs/DateCondition",
                "header": "#/$defs/HeaderCondition",
                "not": "#/$defs/NotExpression",
                "number": "#/$defs/NumberCondition",
                "presence": "#/$defs/PresenceCondition",
                "template": "#/$defs/Template_Expression_",
                "text": "#/$defs/TextCondition"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/AllExpression"
              },
              {
                "$ref": "#/$defs/AnyExpression"
              },
              {
                "$ref": "#/$defs/NotExpression"
              },
              {
                "$ref": "#/$defs/TextCondition"
              },
              {
                "$ref": "#/$defs/HeaderCondition"
              },
              {
                "$ref": "#/$defs/AddressCondition"
              },
              {
                "$ref": "#/$defs/NumberCondition"
              },
              {
                "$ref": "#/$defs/DateCondition"
              },
              {
                "$ref": "#/$defs/BoolCondition"
              },
              {
                "$ref": "#/$defs/PresenceCondition"
              },
              {
                "$ref": "#/$defs/Template_Expression_"
              }
            ]
          },
          "minItems": 1,
          "title": "Conditions",
          "type": "array"
        }
      },
      "required": [
        "conditions"
      ],
      "title": "AnyExpression",
      "type": "object"
    },
    "BoolCondition": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "bool",
          "default": "bool",
          "title": "Type",
          "type": "string"
        },
        "field": {
          "$ref": "#/$defs/Templatable_BoolField_"
        },
        "value": {
          "$ref": "#/$defs/Templatable_bool_",
          "default": true
        },
        "quantifier": {
          "$ref": "#/$defs/Templatable_Quantifier_",
          "default": "any"
        }
      },
      "required": [
        "field"
      ],
      "title": "BoolCondition",
      "type": "object"
    },
    "BoolField": {
      "description": "Boolean fields.",
      "enum": [
        "seen",
        "flagged",
        "answered",
        "draft",
        "deleted",
        "spam_flag",
        "is_reply",
        "has_list_unsubscribe",
        "attachment_inline"
      ],
      "title": "BoolField",
      "type": "string"
    },
    "CompareOperator": {
      "enum": [
        "eq",
        "ne",
        "lt",
        "gt",
        "gte",
        "lte",
        "between"
      ],
      "title": "CompareOperator",
      "type": "string"
    },
    "DateCondition": {
      "additionalProperties": false,
      "description": "Compares a date. A relative value `7d` is the moment 7 days before now.",
      "properties": {
        "type": {
          "const": "date",
          "default": "date",
          "title": "Type",
          "type": "string"
        },
        "field": {
          "$ref": "#/$defs/Templatable_DateField_"
        },
        "operator": {
          "$ref": "#/$defs/Templatable_CompareOperator_"
        },
        "value": {
          "$ref": "#/$defs/Templatable_Union_Annotated_Union_AbsoluteTime__RelativeDuration___FieldInfo_annotation_NoneType__required_True__discriminator__relative_____tuple_Annotated_Union_AbsoluteTime__RelativeDuration___FieldInfo_annotation_NoneType__required_True__discriminator__relative_____Annotated_Union_AbsoluteTime__RelativeDuration___FieldInfo_annotation_NoneType__required_True__discriminator__relative______"
        }
      },
      "required": [
        "field",
        "operator",
        "value"
      ],
      "title": "DateCondition",
      "type": "object"
    },
    "DateField": {
      "description": "Date and time fields.",
      "enum": [
        "date_sent",
        "date_received"
      ],
      "title": "DateField",
      "type": "string"
    },
    "FlagAction": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "flag",
          "default": "flag",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/Templatable_bool_",
          "default": true
        }
      },
      "title": "FlagAction",
      "type": "object"
    },
    "HeaderCondition": {
      "additionalProperties": false,
      "description": "Compares any header by name, for fields without a dedicated entry. Multiple headers of that name are quantified.",
      "properties": {
        "type": {
          "const": "header",
          "default": "header",
          "title": "Type",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/Templatable_Annotated_str__FieldInfo_annotation_NoneType__required_True__metadata__MinLen_min_length_1_____"
        },
        "operator": {
          "$ref": "#/$defs/Templatable_TextOperator_"
        },
        "value": {
          "$ref": "#/$defs/Templatable_Union_str__list_str___"
        },
        "case_sensitive": {
          "$ref": "#/$defs/Templatable_bool_",
          "default": false
        },
        "quantifier": {
          "$ref": "#/$defs/Templatable_Quantifier_",
          "default": "any"
        }
      },
      "required": [
        "name",
        "operator",
        "value"
      ],
      "title": "HeaderCondition",
      "type": "object"
    },
    "KeywordAction": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "keyword",
          "default": "keyword",
          "title": "Type",
          "type": "string"
        },
        "keyword": {
          "$ref": "#/$defs/Templatable_Annotated_str__FieldInfo_annotation_NoneType__required_True__metadata__MinLen_min_length_1_____"
        },
        "value": {
          "$ref": "#/$defs/Templatable_bool_",
          "default": true
        }
      },
      "required": [
        "keyword"
      ],
      "title": "KeywordAction",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "description": "Where a rule applies. The account is referenced by its immutable id, never by its changeable name.",
      "properties": {
        "account_id": {
          "$ref": "#/$defs/Templatable_UUID_"
        },
        "folder": {
          "$ref": "#/$defs/Templatable_str_",
          "default": "INBOX"
        },
        "recursive": {
          "$ref": "#/$defs/Templatable_bool_",
          "default": false
        }
      },
      "required": [
        "account_id"
      ],
      "title": "Location",
      "type": "object"
    },
    "MarkReadAction": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "mark_read",
          "default": "mark_read",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "MarkReadAction",
      "type": "object"
    },
    "MarkUnreadAction": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "mark_unread",
          "default": "mark_unread",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "MarkUnreadAction",
      "type": "object"
    },
    "MoveAction": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "move",
          "default": "move",
          "title": "Type",
          "type": "string"
        },
        "folder": {
          "$ref": "#/$defs/Templatable_str_"
        },
        "account_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templatable_UUID_"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Target account; the mail's own account if unset."
        }
      },
      "required": [
        "folder"
      ],
      "title": "MoveAction",
      "type": "object"
    },
    "NotExpression": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "not",
          "default": "not",
          "title": "Type",
          "type": "string"
        },
        "condition": {
          "discriminator": {
            "mapping": {
              "address": "#/$defs/AddressCondition",
              "all": "#/$defs/AllExpression",
              "any": "#/$defs/AnyExpression",
              "bool": "#/$defs/BoolCondition",
              "date": "#/$defs/DateCondition",
              "header": "#/$defs/HeaderCondition",
              "not": "#/$defs/NotExpression",
              "number": "#/$defs/NumberCondition",
              "presence": "#/$defs/PresenceCondition",
              "template": "#/$defs/Template_Expression_",
              "text": "#/$defs/TextCondition"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AllExpression"
            },
            {
              "$ref": "#/$defs/AnyExpression"
            },
            {
              "$ref": "#/$defs/NotExpression"
            },
            {
              "$ref": "#/$defs/TextCondition"
            },
            {
              "$ref": "#/$defs/HeaderCondition"
            },
            {
              "$ref": "#/$defs/AddressCondition"
            },
            {
              "$ref": "#/$defs/NumberCondition"
            },
            {
              "$ref": "#/$defs/DateCondition"
            },
            {
              "$ref": "#/$defs/BoolCondition"
            },
            {
              "$ref": "#/$defs/PresenceCondition"
            },
            {
              "$ref": "#/$defs/Template_Expression_"
            }
          ],
          "title": "Condition"
        }
      },
      "required": [
        "condition"
      ],
      "title": "NotExpression",
      "type": "object"
    },
    "NumberCondition": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "number",
          "default": "number",
          "title": "Type",
          "type": "string"
        },
        "field": {
          "$ref": "#/$defs/Templatable_NumberField_"
        },
        "operator": {
          "$ref": "#/$defs/Templatable_CompareOperator_"
        },
        "value": {
          "$ref": "#/$defs/Templatable_Union_float__tuple_float__float___"
        },
        "quantifier": {
          "$ref": "#/$defs/Templatable_Quantifier_",
          "default": "any"
        }
      },
      "required": [
        "field",
        "operator",
        "value"
      ],
      "title": "NumberCondition",
      "type": "object"
    },
    "NumberField": {
      "description": "Numeric fields.",
      "enum": [
        "size",
        "spam_score",
        "attachments_count",
        "attachment_size",
        "uid",
        "modseq"
      ],
      "title": "NumberField",
      "type": "string"
    },
    "PresenceCondition": {
      "additionalProperties": false,
      "description": "Tests whether a field or header is there (`exists`) or there but without content (`empty`).",
      "properties": {
        "type": {
          "const": "presence",
          "default": "presence",
          "title": "Type",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templatable_Union_TextField__AddressField__NumberField__DateField__BoolField__"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "header": {
          "anyOf": [
            {
              "$ref": "#/$defs/Templatable_Annotated_str__FieldInfo_annotation_NoneType__required_True__metadata__MinLen_min_length_1_____"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operator": {
          "$ref": "#/$defs/Templatable_PresenceOperator_",
          "default": "exists"
        },
        "value": {
          "$ref": "#/$defs/Templatable_bool_",
          "default": true
        }
      },
      "title": "PresenceCondition",
      "type": "object"
    },
    "PresenceOperator": {
      "enum": [
        "exists",
        "empty"
      ],
      "title": "PresenceOperator",
      "type": "string"
    },
    "Quantifier": {
      "description": "For multi-valued fields: how many of the values need to match.",
      "enum": [
        "any",
        "all",
        "none"
      ],
      "title": "Quantifier",
      "type": "string"
    },
    "RelativeDuration": {
      "description": "A moment this long before now, e.g. `7d`: `date_received lt 7d` means received more than a week ago.",
      "properties": {
        "relative": {
          "const": true,
          "title": "Relative",
          "type": "boolean"
        },
        "value": {
          "description": "A number and a unit: s, m, h, d or w.",
          "pattern": "^(\\d+)([smhdw])$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "relative",
        "value"
      ],
      "title": "RelativeDuration",
      "type": "object"
    },
    "Rule": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "enabled": {
          "$ref": "#/$defs/Templatable_bool_",
          "default": true
        },
        "locations": {
          "items": {
            "$ref": "#/$defs/Location"
          },
          "minItems": 1,
          "title": "Locations",
          "type": "array"
        },
        "when": {
          "discriminator": {
            "mapping": {
              "address": "#/$defs/AddressCondition",
              "all": "#/$defs/AllExpression",
              "any": "#/$defs/AnyExpression",
              "bool": "#/$defs/BoolCondition",
              "date": "#/$defs/DateCondition",
              "header": "#/$defs/HeaderCondition",
              "not": "#/$defs/NotExpression",
              "number": "#/$defs/NumberCondition",
              "presence": "#/$defs/PresenceCondition",
              "template": "#/$defs/Template_Expression_",
              "text": "#/$defs/TextCondition"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AllExpression"
            },
            {
              "$ref": "#/$defs/AnyExpression"
            },
            {
              "$ref": "#/$defs/NotExpression"
            },
            {
              "$ref": "#/$defs/TextCondition"
            },
            {
              "$ref": "#/$defs/HeaderCondition"
            },
            {
              "$ref": "#/$defs/AddressCondition"
            },
            {
              "$ref": "#/$defs/NumberCondition"
            },
            {
              "$ref": "#/$defs/DateCondition"
            },
            {
              "$ref": "#/$defs/BoolCondition"
            },
            {
              "$ref": "#/$defs/PresenceCondition"
            },
            {
              "$ref": "#/$defs/Template_Expression_"
            }
          ],
          "title": "When"
        },
        "actions": {
          "description": "Parsed only; nothing executes them yet.",
          "items": {
            "discriminator": {
              "mapping": {
                "flag": "#/$defs/FlagAction",
                "keyword": "#/$defs/KeywordAction",
                "mark_read": "#/$defs/MarkReadAction",
                "mark_unread": "#/$defs/MarkUnreadAction",
                "move": "#/$defs/MoveAction"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/MoveAction"
              },
              {
                "$ref": "#/$defs/MarkReadAction"
              },
              {
                "$ref": "#/$defs/MarkUnreadAction"
              },
              {
                "$ref": "#/$defs/FlagAction"
              },
              {
                "$ref": "#/$defs/KeywordAction"
              }
            ]
          },
          "title": "Actions",
          "type": "array"
        }
      },
      "required": [
        "name",
        "locations",
        "when"
      ],
      "title": "Rule",
      "type": "object"
    },
    "Templatable_AddressField_": {
      "anyOf": [
        {
          "$ref": "#/$defs/AddressField"
        },
        {
          "$ref": "#/$defs/Var"
        }
      ]
    },
    "Templatable_AddressPart_": {
      "anyOf": [
        {
          "$ref": "#/$defs/AddressPart"
        },
        {
          "$ref": "#/$defs/Var"
        }
      ]
    },
    "Templatable_Annotated_str__FieldInfo_annotation_NoneType__required_True__metadata__MinLen_min_length_1_____": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "$ref": "#/$defs/Var"
        }
      ]
    },
    "Templatable_BoolField_": {
      "anyOf": [
        {
          "$ref": "#/$defs/BoolField"
        },
        {
          "$ref": "#/$defs/Var"
        }
      ]
    },
    "Templatable_CompareOperator_": {
      "anyOf": [
        {
          "$ref": "#/$defs/CompareOperator"
        },
        {
          "$ref": "#/$defs/Var"
        }
      ]
    },
    "Templatable_DateField_": {
      "anyOf": [
        {
          "$ref": "#/$defs/DateField"
        },
        {
          "$ref": "#/$defs/Var"
        }
      ]
    },
    "Templatable_NumberField_": {
      "anyOf": [
        {
          "$ref": "#/$defs/NumberField"
        },
        {
          "$ref": "#/$defs/Var"
        }
      ]
    },
    "Templatable_PresenceOperator_": {
      "anyOf": [
        {
          "$ref": "#/$defs/PresenceOperator"
        },
        {
          "$ref": "#/$defs/Var"
        }
      ]
    },
    "Templatable_Quantifier_": {
      "anyOf": [
        {
          "$ref": "#/$defs/Quantifier"
        },
        {
          "$ref": "#/$defs/Var"
        }
      ]
    },
    "Templatable_TextField_": {
      "anyOf": [
        {
          "$ref": "#/$defs/TextField"
        },
        {
          "$ref": "#/$defs/Var"
        }
      ]
    },
    "Templatable_TextOperator_": {
      "anyOf": [
        {
          "$ref": "#/$defs/TextOperator"
        },
        {
          "$ref": "#/$defs/Var"
        }
      ]
    },
    "Templatable_UUID_": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "$ref": "#/$defs/Var"
        }
      ]
    },
    "Templatable_Union_Annotated_Union_AbsoluteTime__RelativeDuration___FieldInfo_annotation_NoneType__required_True__discriminator__relative_____tuple_Annotated_Union_AbsoluteTime__RelativeDuration___FieldInfo_annotation_NoneType__required_True__discriminator__relative_____Annotated_Union_AbsoluteTime__RelativeDuration___FieldInfo_annotation_NoneType__required_True__discriminator__relative______": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "false": "#/$defs/AbsoluteTime",
              "true": "#/$defs/RelativeDuration"
            },
            "propertyName": "relative"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AbsoluteTime"
            },
            {
              "$ref": "#/$defs/RelativeDuration"
            }
          ]
        },
